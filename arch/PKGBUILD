# Maintainer: CharOfString <root@charofstring.cc>
pkgname=gxde-calendar
pkgver=6.0.6
pkgrel=1
pkgdesc='Calendar software for GXDE OS'
arch=('x86_64' 'aarch64')
url="https://github.com/GXDE-OS/gxde-calendar"
license=('GPL-3.0-or-later')
# 3rdparty/kcalendarcore 静态链接进程序，需要 libical ・ The bundled kcalendarcore is linked in statically and needs libical.
depends=('dtk2widget-qt6' 'gxde-dtk6core' 'qt6-base' 'libical' 'hicolor-icon-theme' 'libgcc'
         'libstdc++' 'glibc')
makedepends=('git' 'cmake' 'ninja' 'pkgconf' 'qt6-tools' 'gxde-deepin-gettext-tools')
provides=("gxde-calendar-git=$pkgver")
conflicts=('gxde-calendar-git')
replaces=('gxde-calendar-git')
source=()
sha512sums=()

# 直接使用 PKGBUILD 所在的 git 仓库作为源码 ・ Build from the git checkout this PKGBUILD lives in.
_srcroot() {
  git -C "$startdir" rev-parse --show-toplevel
}

build() {
  cmake -B build -S "$(_srcroot)" -GNinja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr
  ninja -C build
}

package() {
  DESTDIR="$pkgdir" ninja -C build install
}
